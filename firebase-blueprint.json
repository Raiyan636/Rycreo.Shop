{
  "entities": {
    "StoreData": {
      "title": "StoreData",
      "description": "Global catalog, configuration, and content for RycreoShop",
      "type": "object",
      "properties": {
        "storeConfig": {
          "type": "object",
          "description": "Store configuration, contact, and branding"
        },
        "products": {
          "type": "array",
          "description": "List of products in catalog"
        },
        "categories": {
          "type": "array",
          "description": "List of categories"
        },
        "heroSlides": {
          "type": "array",
          "description": "Hero carousel slides"
        },
        "coupons": {
          "type": "array",
          "description": "Discount vouchers and coupons"
        },
        "reviews": {
          "type": "array",
          "description": "Customer reviews and ratings"
        },
        "quickCategories": {
          "type": "array",
          "description": "Quick collection shortcuts"
        },
        "staticPages": {
          "type": "array",
          "description": "Website static pages"
        },
        "attributes": {
          "type": "array",
          "description": "Product variation attributes"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["storeConfig", "products", "categories", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique order ID"
        },
        "orderNumber": {
          "type": "string",
          "description": "Short customer-facing order number"
        },
        "customerName": {
          "type": "string",
          "description": "Full name of the customer"
        },
        "phone": {
          "type": "string",
          "description": "Primary contact phone number"
        },
        "address": {
          "type": "string",
          "description": "Delivery address"
        },
        "totalAmount": {
          "type": "number",
          "description": "Total order amount in BDT"
        },
        "status": {
          "type": "string",
          "description": "Order status (Pending, Confirmed, Shipped, Delivered, Canceled)"
        },
        "items": {
          "type": "array",
          "description": "List of ordered items"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["id", "orderNumber", "customerName", "phone", "address", "totalAmount", "status", "items", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Registered administrator",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "description": "Role level (admin, superadmin)"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        }
      },
      "required": ["email", "role"]
    },
    "TelemetryLog": {
      "title": "TelemetryLog",
      "description": "Search telemetry record",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search term"
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of query"
        }
      },
      "required": ["query", "timestamp"]
    },
    "PreOrderProduct": {
      "title": "PreOrderProduct",
      "description": "Upcoming pre-order product listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "productCode": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "advanceType": { "type": "string" },
        "advanceValue": { "type": "number" },
        "advanceAmount": { "type": "number" },
        "images": { "type": "array" },
        "colors": { "type": "array" },
        "sizes": { "type": "array" },
        "variations": { "type": "array" },
        "seoTitle": { "type": "string" },
        "seoDescription": { "type": "string" },
        "keywords": { "type": "array" },
        "weWillGetText": { "type": "string" },
        "youWillGetText": { "type": "string" },
        "isVisible": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "price", "isVisible", "createdAt"]
    },
    "PreOrderRecord": {
      "title": "PreOrderRecord",
      "description": "Customer pre-order booking with delivery info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "preOrderNumber": { "type": "string" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "customerName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "quantity": { "type": "number" },
        "totalAmount": { "type": "number" },
        "advancePaidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentTrxId": { "type": "string" },
        "linkedOrderNumber": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "preOrderNumber", "productId", "customerName", "phone", "address", "status", "createdAt"]
    },
    "BuyMoreOffer": {
      "title": "BuyMoreOffer",
      "description": "Buy One Get More promotional product bundle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "productCode": { "type": "string" },
        "badgeText": { "type": "string" },
        "mainProductTitle": { "type": "string" },
        "price": { "type": "number" },
        "images": { "type": "array" },
        "colors": { "type": "array" },
        "sizes": { "type": "array" },
        "seoTitle": { "type": "string" },
        "keywords": { "type": "array" },
        "freeItems": { "type": "array" },
        "isVisible": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "mainProductTitle", "price", "isVisible", "createdAt"]
    },
    "BuyMoreVoucher": {
      "title": "BuyMoreVoucher",
      "description": "Voucher for Buy One Get More offers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "freeProductNote": { "type": "string" },
        "isVisible": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "code", "title", "isVisible", "createdAt"]
    }
  },
  "firestore": {
    "/store/{docId}": {
      "schema": "StoreData",
      "description": "Public store catalog and configuration documents"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Individual customer orders collection"
    },
    "/order_tracking/{orderNumber}": {
      "schema": "Order",
      "description": "Public single order tracking records by exact order number"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators collection"
    },
    "/search_logs/{logId}": {
      "schema": "TelemetryLog",
      "description": "Search telemetry logs"
    },
    "/pre_orders/{preOrderId}": {
      "schema": "PreOrderRecord",
      "description": "Customer pre-order submissions"
    },
    "/pre_order_products/{productId}": {
      "schema": "PreOrderProduct",
      "description": "Upcoming pre-order catalog items"
    },
    "/buy_more_offers/{offerId}": {
      "schema": "BuyMoreOffer",
      "description": "Buy One Get More product deals"
    },
    "/buy_more_vouchers/{voucherId}": {
      "schema": "BuyMoreVoucher",
      "description": "Buy One Get More vouchers"
    }
  }
}
